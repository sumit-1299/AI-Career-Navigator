# ==============================================================================
# AI Career Navigator - Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Database Configuration (PostgreSQL service)
POSTGRES_USER=career_app
POSTGRES_PASSWORD=admin
POSTGRES_DB=career_navigator
POSTGRES_PORT=5434

# Backend Service Configuration
BACKEND_PORT=5001
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
FLASK_ENV=production
FLASK_DEBUG=False
CORS_ORIGINS=*
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Frontend Service Configuration
FRONTEND_PORT=80
