# ==============================================================================
# AI Career Navigator - Production & Development Environment Template
# ==============================================================================
# Copy this file to .env and adjust variables for your target deployment.
# NEVER commit the actual .env file or production credentials to version control.
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://career_app:your_secure_password_here@localhost:5432/career_navigator

# Security & Authentication (JWT)
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-for-production

# Application Environment
# Options: production, development
FLASK_ENV=production
FLASK_DEBUG=False

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed origins or '*' for public API access
# Example for production: https://career-navigator.yourdomain.com,http://localhost:5173
CORS_ORIGINS=*

# WSGI Server Configuration (Gunicorn)
PORT=5000
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=60

# Frontend API Base URL (if building frontend with custom upstream API)
VITE_API_URL=http://localhost:5000
