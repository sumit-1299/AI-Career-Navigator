# Copy to backend/.env for local development and replace both placeholders.
# Generate independent values using the command in docs/LOCAL_SETUP.md.
DATABASE_URL=postgresql+psycopg2://career_app:PASTE_APP_DB_PASSWORD_HERE@127.0.0.1:5432/ai_career_navigator
JWT_SECRET_KEY=PASTE_JWT_SECRET_KEY_HERE

# Password reset / email delivery
# Local default. Replace with your public HTTPS URL after deployment.
APP_BASE_URL=http://127.0.0.1:5000
RESET_TOKEN_MINUTES=30

# Safe for local development only: shows the reset link when SMTP is not configured.
RESET_SHOW_DEBUG_LINK=true

# SMTP settings for real password-reset email delivery.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_USE_TLS=true
